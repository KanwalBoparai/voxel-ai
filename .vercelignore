# Keep the uploaded bundle small and free of local artefacts. The Python
# backend (api/, app/, config/, requirements.txt) is deliberately NOT listed —
# Vercel detects the project as Python by finding api/*.py plus requirements.txt
# at the root, and app/ and config/ are pulled in by includeFiles in vercel.json.

# Local virtualenv — hundreds of MB, and the function installs its own deps.
.venv/
__pycache__/
*.pyc
*.pyo

# Local SQLite databases — production uses Postgres.
*.db
*.sqlite
*.sqlite3

# Secrets: environment variables are configured in the Vercel dashboard.
.env
*.env
service-account*.json
credentials*.json

# Not needed at runtime.
tests/
migrations/
render.yaml
requirements-server.txt
setup.sh
*.md
.git/
.claude/
